APP_NAME="NewPort Maritime Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://newportmaritimeservice.com
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# First admin (see config/admin.php). After edits: php artisan config:clear && php artisan admin:create-user
ADMIN_EMAIL=admin@portmeritime.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=123456

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# cPanel SMTP (Laravel 12 uses MAIL_SCHEME, not MAIL_ENCRYPTION)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.newportmaritimeservice.com
MAIL_PORT=465
MAIL_USERNAME=info@newportmaritimeservice.com
MAIL_PASSWORD=your-cpanel-email-password
# Quote passwords with special characters in double quotes, e.g. MAIL_PASSWORD="p@ss)word"
# TLS alternative: MAIL_PORT=587 and MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=info@newportmaritimeservice.com
MAIL_FROM_NAME="NewPort Maritime Service"
QUOTE_NOTIFICATION_EMAIL=info@newportmaritimeservice.com,hasanrashid8459@gmail.com

# Google reCAPTCHA v2 ("I'm not a robot") — https://www.google.com/recaptcha/admin
# Add newportmaritimeservice.com (and www) as allowed domains.
RECAPTCHA_SITE_KEY=your-live-site-key
RECAPTCHA_SECRET_KEY=your-live-secret-key

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
