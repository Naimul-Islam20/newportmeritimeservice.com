APP_NAME=ERP17
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# First admin (see config/admin.php). After edits: php artisan config:clear && php artisan admin:create-user
ADMIN_EMAIL=admin@portmeritime.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=123456

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — local dev: log driver writes to storage/logs/laravel.log
# Production (cPanel): use smtp and run `php artisan config:clear` after editing .env
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# cPanel example (SSL port 465):
# MAIL_MAILER=smtp
# MAIL_HOST=mail.newportmaritimeservice.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=info@newportmaritimeservice.com
# MAIL_PASSWORD=your-cpanel-email-password
# cPanel example (TLS port 587):
# MAIL_PORT=587
# MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=info@newportmaritimeservice.com
MAIL_FROM_NAME="NewPort Maritime Service"
QUOTE_NOTIFICATION_EMAIL=info@newportmaritimeservice.com

# Google reCAPTCHA v2 ("I'm not a robot") — https://www.google.com/recaptcha/admin
# Register the live domain (newportmaritimeservice.com). Do not use Google test keys on production.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
